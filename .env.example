# Public Supabase Connection (Optional - portal falls back seamlessly to audited dataset)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret Supabase Key for Automated Ingestion & Admin Actions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secret for Scheduled 24h Cron Webhook /api/sync
CRON_SECRET=lnmiit_placement_secret_cron_token_3175

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
